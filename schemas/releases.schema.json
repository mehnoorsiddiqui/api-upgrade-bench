{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "apis/<api>/releases.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["base"],
  "properties": {
    "base": { "$ref": "#/$defs/semver" },
    "releases": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "overlays"],
        "properties": {
          "version": { "$ref": "#/$defs/semver" },
          "overlays": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
          },
          "note": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$" }
  }
}
